{
    "$schema": "http://json.schemastore.org/template",
    "author": "PlatinumTrade",
    "classifications": ["PlatinumTrade", "Indicator"],
    "name": "PlatinumTrade Indicator Template",
    "identity": "Pt.Template.Indicator",
    "shortName": "pt-indicator",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "MyIndicator",
    "preferNameDirectory": true,
    "defaultName": "MyIndicator",
    "symbols": {
        "sdkVersion": {
            "type": "parameter",
            "datatype": "text",
            "description": "Version of the Pt.Okx.Sdk NuGet package to pin in the generated project.",
            "defaultValue": "0.13.0-beta.1",
            "replaces": "SDK_VERSION_PLACEHOLDER"
        },
        "targetFramework": {
            "type": "parameter",
            "datatype": "text",
            "description": "Target framework moniker for the generated indicator project.",
            "defaultValue": "0.13.0-beta.1",
            "replaces": "TARGET_FRAMEWORK_PLACEHOLDER"
        }
    },
    "primaryOutputs": [
        {
            "path": "MyIndicator.csproj"
        }
    ]
}
